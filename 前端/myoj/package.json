{
  "name": "myoj",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:id-contract && npm run check:oj-statement && npm run check:solve-toolbar && npm run check:question-solution && npm run check:question-statistics && npm run check:submission-dashboard && npm run check:account-profile && npm run check:app-header && npm run check:blog-theme && npm run check:auth-recovery && run-p type-check \"build-only {@}\" --",
    "check:id-contract": "node scripts/check-id-contract.mjs",
    "check:oj-statement": "node scripts/check-oj-statement.mjs",
    "check:solve-toolbar": "node scripts/check-solve-toolbar.mjs",
    "check:question-solution": "node scripts/check-question-solution.mjs",
    "check:question-statistics": "node scripts/check-question-statistics.mjs",
    "check:submission-dashboard": "node scripts/check-submission-dashboard.mjs",
    "check:account-profile": "node scripts/check-account-profile.mjs",
    "check:app-header": "node scripts/check-app-header.mjs",
    "check:blog-theme": "node scripts/check-blog-light-theme.mjs",
    "check:auth-recovery": "node scripts/check-auth-recovery.mjs",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/",
    "dev:net": "vite --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "@pansy/china-division": "^2.1.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.14.0",
    "dompurify": "^3.4.2",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "marked": "^18.0.3",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "prismjs": "^1.30.0",
    "vue": "^3.5.31",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.0",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.0",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript-codegen": "^0.30.0",
    "postcss": "^8.5.14",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.0",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
